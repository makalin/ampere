<Window x:Class="Ampere.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚡ AMPERE"
        Width="290"
        Height="200"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Bitmap Winamp Color Palette -->
        <SolidColorBrush x:Key="PanelDeep"    Color="#0D0F0B"/>
        <SolidColorBrush x:Key="PanelDark"    Color="#111408"/>
        <SolidColorBrush x:Key="PanelMid"     Color="#1A1F14"/>
        <SolidColorBrush x:Key="PanelLight"   Color="#2A3020"/>
        <SolidColorBrush x:Key="BevelHigh"    Color="#4A5038"/>
        <SolidColorBrush x:Key="BevelShadow"  Color="#040504"/>
        <SolidColorBrush x:Key="NeonGreen"    Color="#00FF41"/>
        <SolidColorBrush x:Key="NeonDim"      Color="#008C23"/>
        <SolidColorBrush x:Key="Amber"        Color="#FF6600"/>
        <SolidColorBrush x:Key="TextBright"   Color="#D8F2B8"/>
        <SolidColorBrush x:Key="TextDim"      Color="#405030"/>
        <SolidColorBrush x:Key="LcdBg"        Color="#020701"/>

        <!-- Bitmap Button Style -->
        <Style x:Key="AmpButtonStyle" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource PanelLight}"/>
            <Setter Property="Foreground"   Value="{StaticResource TextBright}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource BevelShadow}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="2,1"/>
            <Setter Property="FontFamily"   Value="Courier New"/>
            <Setter Property="FontSize"     Value="9"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0">
                            <!-- Bevel border simulation -->
                            <Border BorderThickness="1,1,0,0" BorderBrush="{StaticResource BevelHigh}">
                                <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource BevelShadow}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource PanelDark}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource NeonGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button (Play) -->
        <Style x:Key="AmpPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AmpButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource NeonGreen}"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>
    </Window.Resources>

    <!-- Root: dark panel background -->
    <Border Background="{StaticResource PanelDeep}"
            BorderBrush="{StaticResource BevelHigh}"
            BorderThickness="1,1,0,0">
        <Border BorderBrush="{StaticResource BevelShadow}" BorderThickness="0,0,1,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="16"/>  <!-- Title bar -->
                    <RowDefinition Height="34"/>  <!-- LCD display -->
                    <RowDefinition Height="18"/>  <!-- Seek + time -->
                    <RowDefinition Height="28"/>  <!-- Transport controls -->
                    <RowDefinition Height="22"/>  <!-- Volume -->
                    <RowDefinition Height="*"/>   <!-- Bottom bar -->
                </Grid.RowDefinitions>

                <!-- ── Title Bar ── -->
                <Grid Grid.Row="0"
                      Background="{StaticResource PanelMid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                        <TextBlock Text="⚡" FontSize="9" Foreground="{StaticResource Amber}" Margin="0,0,2,0"/>
                        <TextBlock Text="AMPERE"
                                   FontFamily="Courier New"
                                   FontSize="8" FontWeight="Bold"
                                   Foreground="{StaticResource NeonGreen}"
                                   CharacterSpacing="200"/>
                    </StackPanel>
                    <!-- State dot -->
                    <Ellipse x:Name="StateIndicator"
                             Grid.Column="1"
                             Width="5" Height="5"
                             Fill="{StaticResource NeonDim}"
                             Margin="0,0,10,0"/>
                </Grid>

                <!-- ── LCD Info Display ── -->
                <Border Grid.Row="1"
                        Background="{StaticResource PanelDark}"
                        Padding="4,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Track info LCD -->
                        <Border Background="{StaticResource LcdBg}"
                                BorderBrush="{StaticResource BevelShadow}"
                                BorderThickness="1,1,0,0"
                                Padding="4,2" Margin="0,0,4,0">
                            <Border BorderBrush="{StaticResource BevelHigh}" BorderThickness="0,0,1,1">
                                <StackPanel>
                                    <TextBlock x:Name="FileNameText"
                                               Text="⚡ Drop a track here…"
                                               FontFamily="Courier New"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource NeonGreen}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="FilePathText"
                                               Text=""
                                               FontFamily="Courier New"
                                               FontSize="7"
                                               Foreground="{StaticResource NeonDim}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Border>
                        <!-- Bitrate readout -->
                        <Border Grid.Column="1"
                                Background="{StaticResource LcdBg}"
                                BorderBrush="{StaticResource BevelShadow}"
                                BorderThickness="1,1,0,0"
                                Width="44" Padding="3,2">
                            <Border BorderBrush="{StaticResource BevelHigh}" BorderThickness="0,0,1,1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="128"
                                               FontFamily="Courier New"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource NeonGreen}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="kbps"
                                               FontFamily="Courier New"
                                               FontSize="6"
                                               Foreground="{StaticResource TextDim}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Seek Bar + Time ── -->
                <Grid Grid.Row="2" Background="{StaticResource PanelDark}" Margin="5,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="0:00"
                               FontFamily="Courier New" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource NeonGreen}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="PositionSlider" Grid.Column="1"
                            Minimum="0" Maximum="1" Value="0"
                            ValueChanged="PositionSlider_ValueChanged"
                            VerticalAlignment="Center" Margin="4,0"
                            Background="{StaticResource LcdBg}"
                            Foreground="{StaticResource NeonDim}"/>
                    <TextBlock x:Name="DurationText" Text="0:00"
                               Grid.Column="2"
                               FontFamily="Courier New" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource NeonGreen}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>

                <!-- ── Transport Controls ── -->
                <Border Grid.Row="3"
                        Background="{StaticResource PanelMid}"
                        Padding="5,3">
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                        <Button Content="⏮" Style="{StaticResource AmpButtonStyle}" Width="28" Height="20"
                                Click="PrevButton_Click"/>
                        <Button Content="⏪" Style="{StaticResource AmpButtonStyle}" Width="28" Height="20"/>
                        <Button x:Name="PlayPauseButton" Content="▶"
                                Style="{StaticResource AmpPlayButtonStyle}"
                                Width="34" Height="20"
                                Click="PlayPauseButton_Click"/>
                        <Button Content="⏹" Style="{StaticResource AmpButtonStyle}" Width="28" Height="20"
                                Click="StopButton_Click"/>
                        <Button Content="⏩" Style="{StaticResource AmpButtonStyle}" Width="28" Height="20"/>
                        <Button Content="⏭" Style="{StaticResource AmpButtonStyle}" Width="28" Height="20"
                                Click="NextButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- ── Volume ── -->
                <Grid Grid.Row="4" Background="{StaticResource PanelDark}" Margin="6,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="VOL" FontFamily="Courier New" FontSize="7" FontWeight="Bold"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1"
                            Minimum="0" Maximum="1" Value="1"
                            ValueChanged="VolumeSlider_ValueChanged"
                            VerticalAlignment="Center"
                            Background="{StaticResource LcdBg}"
                            Foreground="{StaticResource NeonDim}"/>
                    <TextBlock x:Name="VolumeText" Grid.Column="2"
                               Text="100%"
                               FontFamily="Courier New" FontSize="7" FontWeight="Bold"
                               Foreground="{StaticResource NeonGreen}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </Grid>

                <!-- ── Bottom Button Bar ── -->
                <Border Grid.Row="5" Background="{StaticResource PanelDeep}" Padding="4,3">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Content="OPEN" Style="{StaticResource AmpButtonStyle}"
                                Width="36" Height="14" FontSize="7"
                                Click="OpenFileButton_Click"/>
                        <Button Content="EQ"   Style="{StaticResource AmpButtonStyle}"
                                Width="24" Height="14" FontSize="7"/>
                        <Button Content="LIST" Style="{StaticResource AmpButtonStyle}"
                                Width="28" Height="14" FontSize="7"/>
                        <Button Content="ART"  Style="{StaticResource AmpButtonStyle}"
                                Width="28" Height="14" FontSize="7"/>
                        <Button Content="SET"  Style="{StaticResource AmpButtonStyle}"
                                Width="28" Height="14" FontSize="7"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
